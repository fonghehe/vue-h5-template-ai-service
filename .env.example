# ---------------------------------------------------------------------------
# vue-h5-template-ai-service configuration
#
# Every value below is read from the environment (optionally seeded from a
# `.env` file). Copy this file to `.env` and adjust it. Values marked "must
# match the business service" must be identical to the Go service's settings.
# ---------------------------------------------------------------------------

# Service identity -----------------------------------------------------------
# One of: local | development | test | staging | production
APP_ENV=development
DEBUG=false
DOCS_ENABLED=true
# One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# One of: text | json (json is required in production)
LOG_FORMAT=text

# HTTP surface ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL + pgvector is required in production. SQLite is supported only
# for a zero-dependency local checkout and tests.
DATABASE_URL=sqlite+aiosqlite:///./.data/ai-service.db
DATABASE_AUTO_CREATE=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800
READINESS_TIMEOUT_SECONDS=3
MAX_REQUEST_BYTES=6000000

# Security -------------------------------------------------------------------
# Shared secret for gateway-to-service calls. At least 32 bytes in staging/production.
SERVICE_TOKEN=
# When true, anonymous access is refused. Off by default for friction-free
# local development; true is required in staging/production.
AI_AUTH_REQUIRED=false
# Must match the business service.
JWT_SECRET=dev-only-change-me-before-production
JWT_ISSUER=vue-h5-template
JWT_AUDIENCE=vue-h5-template-api

# Provider -------------------------------------------------------------------
# One of: mock | openai-compatible
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
# Whole response deadline, including agent/context and client backpressure.
AI_STREAM_TIMEOUT_SECONDS=90
SSE_HEARTBEAT_SECONDS=15
AI_MAX_OUTPUT_CHARS=20000
AI_MAX_INPUT_CHARS=100000
AI_CONTEXT_TOKEN_BUDGET=8000
AI_SUMMARY_TOKEN_BUDGET=1000
AI_PROVIDER_MAX_RETRIES=3
AI_RETRY_BASE_SECONDS=0.25
MODEL_SIMPLE_CHAT=
MODEL_REASONING=
MODEL_SUMMARIZATION=
MODEL_EMBEDDING=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Agent and business-service tools ------------------------------------------
AGENT_MAX_ITERATIONS=5
BUSINESS_SERVICE_URL=http://localhost:8002
BUSINESS_SERVICE_TOKEN=
BUSINESS_SERVICE_TIMEOUT_SECONDS=5

# Knowledge base ------------------------------------------------------------
KNOWLEDGE_MAX_FILE_BYTES=5000000
KNOWLEDGE_CHUNK_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=200
KNOWLEDGE_TOP_K=5

# Rate limiting --------------------------------------------------------------
AI_RATE_LIMIT_PER_MINUTE=20
AI_CONCURRENT_STREAM_LIMIT=3
AI_DAILY_TOKEN_LIMIT=200000
# Empty uses in-process coordination locally. Required in staging/production.
REDIS_URL=
REDIS_MAX_CONNECTIONS=50

# Observability -------------------------------------------------------------
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=vue-h5-template-ai-service
